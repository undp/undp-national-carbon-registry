# =============================================================================
# replicator + async-operations-handler service environment variables
# Used by: replicator container
# =============================================================================
# Copy to .env.replicator and fill in real values. NEVER commit .env.replicator.

# -----------------------------------------------------------------------------
# JWT Secrets  [REQUIRED — must match values in .env.national]
# Use: openssl rand -hex 32   to generate each value
# -----------------------------------------------------------------------------
USER_JWT_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_JWT_SECRET=replace-with-a-different-long-random-string
ADMIN_JWT_SECRET=replace-with-yet-another-long-random-string

# -----------------------------------------------------------------------------
# Async queue  [REQUIRED — service will not start without this]
# For local dev (ASYNC_OPERATIONS_TYPE=Database), any non-empty string works
# For AWS: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>.fifo
# -----------------------------------------------------------------------------
ASYNC_QUEUE_NAME=local-not-used

# -----------------------------------------------------------------------------
# Email / SMTP  [REQUIRED — service will not start without these]
# Set IS_EMAIL_DISABLED=true for local development
# -----------------------------------------------------------------------------
IS_EMAIL_DISABLED=true
DISABLE_LOW_PRIORITY_EMAIL=true
EMAILPREFIX=
SMTP_ENDPOINT=email-smtp.us-east-1.amazonaws.com
SMTP_USERNAME=AKIAIOSFODNN7EXAMPLEEXAMPLE   # Replace with your SES IAM access key
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Host / URL
# -----------------------------------------------------------------------------
BACKEND_HOST=http://localhost:3000   # URL of the national-api reachable from this container
# Public URL of the frontend. Set this even though nothing in this container
# serves it — CAD Trust v2 sync (below) runs here and stamps every synced
# project's `projectLink` with it. Left unset it defaults to
# http://localhost:3030, which is published as-is to the CAD Trust network.
HOST=http://localhost:3030

# -----------------------------------------------------------------------------
# System / Country Configuration
# -----------------------------------------------------------------------------
# Only needed here for CADT_V2_REGISTRY_NAME / CADT_V2_COMMIT_AUTHOR
# below to fall back to something other than the "SystemX" placeholder.
SYSTEM_NAME=SystemX

# -----------------------------------------------------------------------------
# File Storage
# The replicator generates documents too, so it needs the same settings as the
# national-api.
# -----------------------------------------------------------------------------
FILE_SERVICE=LOCAL                   # LOCAL | S3 | AZURE
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=files

# -----------------------------------------------------------------------------
# MRV / Registry Sync (optional — disabled by default)
# -----------------------------------------------------------------------------
SYNC_ENABLE=false
MRV_ENDPOINT=
MRV_API_TOKEN=

# -----------------------------------------------------------------------------
# ITMO System Integration (optional — disabled by default)
# -----------------------------------------------------------------------------
ITMO_API_KEY=
ITMO_EMAIL=
ITMO_PASSWORD=

# -----------------------------------------------------------------------------
# CADT v2 client (@app/cadtrust) — optional, disabled by default
# This container is where the CAD Trust sync actually runs: RUN_MODULE here
# includes async-operations-handler, which is the consumer that stages and
# commits to the node. See libs/shared/src/cadtrust-sync/README.md and the
# CADT v2 block in backend/services/.env.example for the full explanation of
# every key. CADT_V2_ENABLE must match the value set in .env.national, or
# actions are enqueued there and never consumed here (or vice versa).
# -----------------------------------------------------------------------------
CADT_V2_ENABLE=false
# Include the /v2 prefix. If the CADT node runs on the host machine, this
# container needs host.docker.internal (or the host LAN IP) instead of
# localhost — localhost here means the container.
CADT_V2_BASE_URL=http://localhost:31310/v2
# Only needed when the CADT node itself was started with CADT_API_KEY set.
CADT_V2_API_KEY=
CADT_V2_TIMEOUT_MS=30000
# Published as `projectRegistryName` on every synced project. Defaults to
# SYSTEM_NAME above.
CADT_V2_REGISTRY_NAME=
# Recorded as the author of each staging commit. Defaults to SYSTEM_NAME above.
CADT_V2_COMMIT_AUTHOR=

# Bootstrap (runs once per start, no-ops once done — see the module README).
# Verifies the CAD Trust home organization exists and stages this registry's
# one program and one methodology. The organization itself is NEVER created
# here — it must already exist on the node before CADT_V2_ENABLE is turned on,
# or the ORGANIZATION sync record goes FAILED and nothing else is attempted.
#
# Used only for logging and the organization check — no organization is
# created from this value.
CADT_V2_ORG_NAME=
# Required by CAD Trust. Left unset, this defaults to
# "${systemCountryName} National Carbon Crediting Program" — which is the
# "CountryX" placeholder trap again if systemCountryName is also unset.
CADT_V2_PROGRAM_NAME=
# Required. Defaults to CADT_V2_REGISTRY_NAME / SYSTEM_NAME above.
CADT_V2_PROGRAM_REGISTRY=
# Required. Defaults to systemCountryCode. A program cannot be deleted once any
# project references it (CAD Trust returns a 409), so get this right before
# enabling — see CadTrustRegistryProfileService.assertConfigured(), which
# refuses to stage a program or methodology at all while every fallback below
# is still a placeholder.
CADT_V2_PROGRAM_REGISTRY_ACTIVITY_ID=
CADT_V2_PROGRAM_REGISTRY_PROGRAM_ID=
CADT_V2_PROGRAM_DESCRIPTION=
# Required. Defaults to "${systemCountryCode}-NCC".
CADT_V2_METHODOLOGY_CODE=
# Required. Defaults to "National Carbon Crediting".
CADT_V2_METHODOLOGY_NAME=
CADT_V2_METHODOLOGY_VERSION=
CADT_V2_METHODOLOGY_DATE=
CADT_V2_METHODOLOGY_LINK=
# Picklist "methodology_type" — leave unset unless you have checked it against
# GET /v2/governance/meta/pickList on the target node; unlike the fields above
# this one is optional, so bootstrap does not need it to succeed.
CADT_V2_METHODOLOGY_TYPE=
# Picklist "validation_body" — always used as the validationBody on every CAD Trust
# validation sync (never the real Independent Certifier's name, which is never a
# match against CAD Trust's closed ~90-name VVB list). Defaults to "DNV", a real
# entry in that list; reconfirm against GET /v2/governance/meta/pickList on the
# target node before go-live.
CADT_V2_VALIDATION_BODY=

# How often (ms) the CAD Trust-only async lane (RUN_MODULE=cadtrust-operations-handler,
# see below) re-runs the reconcile pass — retries any FAILED sync record and any
# staged-but-uncommitted batch. Defaults to 5 minutes. This is what actually retries a
# staging/commit call that failed because a previous commit was still propagating on
# CAD Trust's side; see libs/shared/src/cadtrust-sync/README.md.
CADT_V2_RECONCILE_INTERVAL_MS=
# Consecutive commit-failure count past which CadTrustCommitHandler logs a one-time
# "this may need a human" warning naming POST /staging/reset-committed, instead of
# quietly retrying forever. Defaults to 6 (roughly 30 min at the default reconcile
# interval). That endpoint is never called automatically — it resets every tenant's
# stuck rows on a shared node; see libs/cadtrust/README.md before ever running it
# manually.
CADT_V2_COMMIT_STUCK_THRESHOLD=
# Per-record cap on attemptCount past which CadTrustReconcileHandler stops re-driving a
# FAILED project/snapshot/credit-block sync record — otherwise a permanently broken record
# would be retried forever, every reconcile tick. Defaults to 10. A record that crosses this
# is left alone by reconcile; CADT_V2_COMMIT_STUCK_THRESHOLD above is the separate signal
# that surfaces stuck records to an operator.
CADT_V2_RECONCILE_MAX_ATTEMPTS=

# -----------------------------------------------------------------------------
# CAD Trust's own async lane (RUN_MODULE=cadtrust-operations-handler)
# -----------------------------------------------------------------------------
# Runs alongside `replicator,async-operations-handler` in this same container (see
# docker-compose.yml). Reads its own cursor (CounterType.CADTRUST_ASYNC_OPERATIONS) over
# the same async_action_entity table the shared lane reads — CAD Trust actions are
# excluded from the shared lane's query and vice versa, so the two never overlap and a
# slow/retrying CAD Trust call never delays email. See
# src/async-operations-handler/cadtrust-async-operations-handler.service.ts.
