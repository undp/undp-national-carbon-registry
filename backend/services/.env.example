# =============================================================================
# Carbon Registry – Backend Environment Variables
# =============================================================================
# Copy this file to .env.dev or .env.prod and fill in real values.
# NEVER commit files containing real secrets to version control.
# Variables marked [REQUIRED] will cause the service to refuse to start if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime / Stage
# -----------------------------------------------------------------------------
STAGE=local                         # local | dev | prod
NODE_ENV=dev                # dev | prod

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=hquser
DB_PASSWORD=changeme
DB_NAME=carbondev
# Set to "true" only for local dev or test — never in production (use migrations instead)
DB_SYNCHRONIZE=false
# Set to "true" to run pending TypeORM migrations automatically on app start
DB_MIGRATIONS_RUN=false

# -----------------------------------------------------------------------------
# JWT Secrets  [REQUIRED — no default, service will not start without these]
# -----------------------------------------------------------------------------
USER_JWT_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_JWT_SECRET=replace-with-a-different-long-random-string
ADMIN_JWT_SECRET=replace-with-yet-another-long-random-string

# JWT expiry
EXPIRES_IN=7200
REFRESH_TOKEN_EXPIRES_IN=12h

# -----------------------------------------------------------------------------
# Email / SMTP  [REQUIRED — no default, service will not start without these]
# -----------------------------------------------------------------------------
SMTP_ENDPOINT=email-smtp.us-east-1.amazonaws.com
SMTP_USERNAME=EXAMPLE   # IAM access key for SES — replace with your own
SMTP_PASSWORD=                       # SES SMTP password (different from IAM secret key)
SOURCE_EMAIL=noreply@example.org
IS_EMAIL_DISABLED=true               # Set to false in production
DISABLE_LOW_PRIORITY_EMAIL=true
EMAILPREFIX=
HOST_ADDRESS=Address <br>Region, Country Zipcode
EMAIL_CONFIG_SET=

# -----------------------------------------------------------------------------
# Async Queue  [REQUIRED — no default, service will not start without this]
# -----------------------------------------------------------------------------
# For local dev with ASYNC_OPERATIONS_TYPE=Database, any non-empty string works.
# For AWS SQS: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>.fifo
ASYNC_QUEUE_NAME=local-not-used
ASYNC_OPERATIONS_TYPE=Database      # Database | Queue

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
FILE_SERVICE=LOCAL                  # LOCAL | S3 | AZURE
S3_COMMON_BUCKET=carbon-common-dev

# Required when FILE_SERVICE=AZURE. The container must allow anonymous blob read, and the
# account needs a CORS rule for the frontend origin allowing GET,HEAD,OPTIONS - HEAD included,
# because file-saver probes with it before downloading - or document downloads will not work.
AZURE_STORAGE_CONNECTION_STRING=    # DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=files

# -----------------------------------------------------------------------------
# Location Service
# -----------------------------------------------------------------------------
LOCATION_SERVICE=FILE               # FILE | OPENSTREET | MAPBOX
MAPBOX_PK=                          # Mapbox public token (required if LOCATION_SERVICE=MAPBOX)
OPENSTREET_QUERY=false

# -----------------------------------------------------------------------------
# Ledger
# -----------------------------------------------------------------------------
LEDGER_TYPE=NONE                    # NONE | QLDB
carbon_dev_common=carbon-common-dev

# -----------------------------------------------------------------------------
# Host URLs
# -----------------------------------------------------------------------------
HOST=http://localhost:3030           # Public URL of the frontend (used in emails, documents)
BACKEND_HOST=http://localhost:3000   # Internal URL of the national-api (used by replicator)

# -----------------------------------------------------------------------------
# Registry Sync (optional — disabled by default)
# -----------------------------------------------------------------------------
SYNC_ENABLE=false
SYNC_ENDPOINT=
SYNC_API_TOKEN=

# -----------------------------------------------------------------------------
# ITMO System Integration (optional — disabled by default)
# -----------------------------------------------------------------------------
ITMO_ENABLE=false
ITMO_ENDPOINT=
ITMO_API_KEY=
ITMO_EMAIL=
ITMO_PASSWORD=

# -----------------------------------------------------------------------------
# CADT (CAD Trust) Integration (optional — disabled by default)
# -----------------------------------------------------------------------------
CADTRUST_ENABLE=false
CADTRUST_ENDPOINT=

# -----------------------------------------------------------------------------
# CADT v2 client (@app/cadtrust) — optional, disabled by default
# Independent of the v1 settings above: a CADT node runs v1 and v2 side by side
# with isolated data stores, so both blocks can be populated at the same time.
#
# Split across two processes — see libs/shared/src/cadtrust-sync/README.md:
#   - national-api  (this process, RUN_MODULE=national-api) only reads
#     CADT_V2_ENABLE: it gates whether a sync action is enqueued at all.
#   - replicator     (RUN_MODULE=...,async-operations-handler) reads every
#     other key below: that is the process that actually talks to the node.
# Set CADT_V2_ENABLE the same way in both processes' env — if it's true here
# but false on the replicator, actions get enqueued and never consumed; the
# reverse means nothing is ever enqueued and the flag on the replicator does
# nothing.
# -----------------------------------------------------------------------------
CADT_V2_ENABLE=false
# Include the /v2 prefix. Defaults to http://localhost:31310/v2 when unset.
# If the CADT node runs on your host machine and this process runs in a
# container (the replicator does, in docker-compose.yml), "localhost" means
# the container itself — use host.docker.internal or the host's LAN IP.
CADT_V2_BASE_URL=http://localhost:31310/v2
# Only needed when the CADT node itself was started with CADT_API_KEY set.
# Sent as the x-api-key header on every request, including /health.
CADT_V2_API_KEY=
CADT_V2_TIMEOUT_MS=30000
# Published as `projectRegistryName` on every synced project — this leaves the
# registry. Defaults to SYSTEM_NAME (below), which itself defaults to the
# placeholder "SystemX" — leaving both unset silently publishes "SystemX".
CADT_V2_REGISTRY_NAME=
# Recorded as the author of each staging commit. Same SYSTEM_NAME fallback,
# same "SystemX" trap, as CADT_V2_REGISTRY_NAME above.
CADT_V2_COMMIT_AUTHOR=
# projectLink on every synced project is built from HOST as
# `${HOST}/programmeManagement/view/{refId}` — see the "Host URLs" section of
# this file. It's computed inside the replicator process, so HOST must be set
# in .env.replicator (its own example has no default and falls back to
# http://localhost:3030) or every published project links to localhost.
#
# Bootstrap (replicator only, like every key above except CADT_V2_ENABLE).
# CadTrustBootstrapHandler verifies the CAD Trust home organization on every
# national-api start and stages this registry's one program and one
# methodology if not already synced — see
# libs/shared/src/cadtrust-sync/handlers/bootstrap.handler.ts. The organization
# itself is NEVER created here: it must already exist on the node, or the
# ORGANIZATION sync record goes FAILED and program/methodology are never
# attempted. Organization creation is a ~30-minute node-onboarding operation
# and must not run inside the async-operations queue.
#
# Used only for logging and the verify-only organization check.
CADT_V2_ORG_NAME=
# Required by CAD Trust. Defaults to
# "${systemCountryName} National Carbon Crediting Program".
CADT_V2_PROGRAM_NAME=
# Required. Defaults to CADT_V2_REGISTRY_NAME / SYSTEM_NAME (above).
CADT_V2_PROGRAM_REGISTRY=
# Required. Defaults to systemCountryCode (below). A program cannot be deleted
# once any project references it (CAD Trust returns a 409 referential-integrity
# error), so this is worth getting right before enabling —
# CadTrustRegistryProfileService.assertConfigured() refuses to stage a program
# or methodology at all while every fallback for a required field is still a
# placeholder ("CountryX" / "SystemX" / the hardcoded "NG" country-code default).
CADT_V2_PROGRAM_REGISTRY_ACTIVITY_ID=
CADT_V2_PROGRAM_REGISTRY_PROGRAM_ID=
CADT_V2_PROGRAM_DESCRIPTION=
# Required. Defaults to "${systemCountryCode}-NCC".
CADT_V2_METHODOLOGY_CODE=
# Required. Defaults to "National Carbon Crediting".
CADT_V2_METHODOLOGY_NAME=
CADT_V2_METHODOLOGY_VERSION=
CADT_V2_METHODOLOGY_DATE=
CADT_V2_METHODOLOGY_LINK=
# Picklist "methodology_type" — optional, and left unset by default so
# bootstrap does not need a live picklist fetch to succeed. Only set this after
# checking it against GET /v2/governance/meta/pickList on the target node.
CADT_V2_METHODOLOGY_TYPE=
# Picklist "validation_body" — always used as the validationBody on every CAD Trust validation
# sync (never the real Independent Certifier's name; see mappers/validation.mapper.ts for why).
# Defaults to "DNV", a real entry in CAD Trust's ~90-name VVB list. Reconfirm against
# GET /v2/governance/meta/pickList on the target node before go-live.
CADT_V2_VALIDATION_BODY=

# -----------------------------------------------------------------------------
# System / Country Configuration
# -----------------------------------------------------------------------------
systemCountryCode=NG
systemCountryName=CountryX
systemContinentName=CountryX
countryClimateFundName=CountryX Climate Fund (Pvt) Ltd
defaultCreditUnit=ITMO
REPORT_YEAR=2024
SYSTEM_TYPE=CARBON_UNIFIED_SYSTEM
SYSTEM_NAME=SystemX
DOMAIN_MAP=false

# -----------------------------------------------------------------------------
# Document Generation
# -----------------------------------------------------------------------------
MINISTER_NAME=Minister X
MINISTER_NAME_AND_DESIGNATION=\nHonorable Minister X\nMinister\nMinistry of Environment
COUNTRY_CAPITAL=Capital X
CONTACT_EMAIL=contactus@example.org

# -----------------------------------------------------------------------------
# Certifier Image
# -----------------------------------------------------------------------------
CERTIFIER_IMAGE=

# -----------------------------------------------------------------------------
# Cache (milliseconds / record count)
# -----------------------------------------------------------------------------
CACHE_PROJECT_TTL=60000
CACHE_PROJECT_MAX=100
CACHE_RETIREMENT_TTL=60000
CACHE_RETIREMENT_MAX=100
CACHE_ORGANISATION_TTL=60000
CACHE_ORGANISATION_MAX=100

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
ENCODE_PASSWORD=false
SALT_ROUNDS=10
MRV_ENDPOINT=

# -----------------------------------------------------------------------------
# AEF V2 (@app/aef-v2)
# -----------------------------------------------------------------------------
# ISO 3166-1 alpha-3. Falls back to an alpha-3 lookup of systemCountryCode
# when unset.
AEF_PARTY=
# Alpha-3 + 2 digits, e.g. VUT01. No registry source for this.
AEF_PARTY_ITMO_REGISTRY_ID=
AEF_NDC_FIRST_YEAR=2021
AEF_NDC_LAST_YEAR=2030
AEF_DEFAULT_MITIGATION_TYPE=Emission reductions
# blocks | actions — see AEF_V2.holdingsSource in configuration.ts
AEF_HOLDINGS_SOURCE=blocks
AEF_STRICT_WRITE=true
AEF_SUBMISSION_ENABLED=false
AEF_SUBMISSION_ENDPOINT=
AEF_SUBMISSION_API_KEY=
AEF_SUBMISSION_TIMEOUT_MS=30000
# In-process start-of-year rollover cron in national-api (fires 01:00 UTC,
# 1 January). Set to false on serverless deployments (which use the
# `aef-rollover` scheduled function instead) or when running more than one
# national-api replica.
AEF_ROLLOVER_CRON_ENABLED=true
